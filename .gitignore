# The real denylist never leaves this machine.
guard/denylist.local

# Any *.local file is machine-private by convention.
*.local

# The example IS committed; the catch-all above must not swallow it.
!guard/denylist.example

.DS_Store
__pycache__/
*.pyc
*.swp
*~
harness-backup-*/

# Guard runtime artifacts. Each guard resolves its log and its edit-boundary
# state next to the script that is running, so invoking one straight out of the
# repo tree (a manual probe, a test run with GUARD_LOG unset) drops these here.
# They hold absolute paths, which is exactly what guard/scan.sh hunts, and the
# scanner only sees TRACKED files, so an untracked one would ride along on the
# first `git add -A`.
guard.log
**/hooks/state/
